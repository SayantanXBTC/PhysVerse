PORT=5001
MONGODB_URI=mongodb://localhost:27017/physverse
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development
FRONTEND_URL=https://your-app.netlify.app
# Comma-separated list of additional allowed origins for CORS
ALLOWED_ORIGINS=

# Google OAuth (create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials)
# Must match VITE_GOOGLE_CLIENT_ID in the frontend
GOOGLE_CLIENT_ID=

# Email (optional — leave empty for no-op dev mode)
EMAIL_PROVIDER=              # 'resend' | 'sendgrid' | '' (none)
EMAIL_FROM=PhysVerse <noreply@yourdomain.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
