import * as THREE from 'three';
import { PhysicsSimulation, SimulationParameterDefinition, SimulationState, SimulationMetadata } from '../types';

export class PlasmaSimulation implements PhysicsSimulation {
  metadata: SimulationMetadata = {
    id: 'plasma',
    name: 'Plasma Physics',
    description: 'Tokamak fusion reactor with magnetic confinement, plasma instabilities, and fusion reactions',
    category: 'Plasma',
    difficulty: 'advanced',
    tags: ['plasma', 'ionization', 'electromagnetic', 'fusion', 'tokamak'],
    premium: true
  };

  parameters: Record<string, SimulationParameterDefinition> = {
    temperature: { 
      label: 'Temperature (K)', 
      type: 'number', 
      default: 50000, 
      min: 10000, 
      max: 150000, 
      step: 10000, 
      description: 'Plasma temperature in Kelvin' 
    },
    density: {
      label: 'Particle Density',
      type: 'number',
      default: 1,
      min: 0.3,
      max: 2,
      step: 0.1,
      description: 'Plasma particle density'
    },
    showFusion: {
      label: 'Show Fusion Reactions',
      type: 'boolean',
      default: true,
      description: 'Display fusion reaction events'
    }
  };

  private group: THREE.Group | null = null;
  private ions: THREE.Points | null = null;
  private electrons: THREE.Points | null = null;
  private ionVelocities: THREE.Vector3[] = [];
  private electronVelocities: THREE.Vector3[] = [];
  private fusionFlashes: THREE.Mesh[] = [];
  private magneticFieldLines: THREE.Line[] = [];
  private time = 0;
  private fusionTimer = 0;
  private params: Record<string, unknown> = {};
  private scene: THREE.Scene | null = null;

  initialize(scene: THREE.Scene, params: Record<string, unknown>): void {
    this.time = 0;
    this.fusionTimer = 0;
    this.params = params;
    this.scene = scene;
    this.group = new THREE.Group();
    this.ionVelocities = [];
    this.electronVelocities = [];
    this.fusionFlashes = [];
    this.magneticFieldLines = [];

    const density = (params.density as number) || 1;
    const temperature = (params.temperature as number) || 50000;
    const showFusion = params.showFusion !== false;
    const particleCount = Math.floor(200 * density);

    // Tokamak magnetic confinement coils
    for (let i = 0; i < 12; i++) {
      const angle = (i / 12) * Math.PI * 2;
      const coilGeometry = new THREE.TorusGeometry(4, 0.25, 24, 48);
      const coilMaterial = new THREE.MeshStandardMaterial({ 
        color: 0x555555,
        metalness: 0.9,
        roughness: 0.1,
        emissive: 0x222222,
        emissiveIntensity: 0.2
      });
      const coil = new THREE.Mesh(coilGeometry, coilMaterial);
      coil.rotation.y = angle;
      coil.rotation.x = Math.PI / 2;
      this.group.add(coil);
    }

    // Magnetic field lines visualization
    for (let i = 0; i < 8; i++) {
      const angle = (i / 8) * Math.PI * 2;
      const points: THREE.Vector3[] = [];
      for (let j = 0; j < 64; j++) {
        const t = (j / 64) * Math.PI * 2;
        const radius = 3 + Math.sin(t * 3) * 0.2;
        points.push(new THREE.Vector3(
          Math.cos(t + angle) * radius,
          Math.sin(t * 2) * 0.3,
          Math.sin(t + angle) * radius
        ));
      }
      const lineGeometry = new THREE.BufferGeometry().setFromPoints(points);
      const lineMaterial = new THREE.LineBasicMaterial({
        color: 0x4488ff,
        transparent: true,
        opacity: 0.15
      });
      const line = new THREE.Line(lineGeometry, lineMaterial);
      this.group.add(line);
      this.magneticFieldLines.push(line);
    }

    // Ion particles (positive charge - red/orange)
    const ionGeometry = new THREE.BufferGeometry();
    const ionPositions = new Float32Array(particleCount * 3);
    const ionColors = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      const angle = (i / particleCount) * Math.PI * 2;
      const radius = 2.5 + (Math.random() - 0.5) * 0.8;
      const height = (Math.random() - 0.5) * 0.6;
      
      ionPositions[i * 3] = Math.cos(angle) * radius;
      ionPositions[i * 3 + 1] = height;
      ionPositions[i * 3 + 2] = Math.sin(angle) * radius;

      // Temperature-based color (hotter = whiter)
      const tempFactor = temperature / 150000;
      const color = new THREE.Color().setHSL(0.05, 1 - tempFactor * 0.5, 0.5 + tempFactor * 0.3);
      ionColors[i * 3] = color.r;
      ionColors[i * 3 + 1] = color.g;
      ionColors[i * 3 + 2] = color.b;

      // Initial velocities based on temperature
      const speed = Math.sqrt(temperature / 10000) * 0.3;
      this.ionVelocities.push(new THREE.Vector3(
        (Math.random() - 0.5) * speed,
        (Math.random() - 0.5) * speed * 0.3,
        (Math.random() - 0.5) * speed
      ));
    }

    ionGeometry.setAttribute('position', new THREE.BufferAttribute(ionPositions, 3));
    ionGeometry.setAttribute('color', new THREE.BufferAttribute(ionColors, 3));

    const ionMaterial = new THREE.PointsMaterial({
      size: 0.15,
      vertexColors: true,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending
    });

    this.ions = new THREE.Points(ionGeometry, ionMaterial);
    this.group.add(this.ions);

    // Electron particles (negative charge - blue/cyan)
    const electronGeometry = new THREE.BufferGeometry();
    const electronPositions = new Float32Array(particleCount * 3);
    const electronColors = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      const angle = (i / particleCount) * Math.PI * 2 + 0.1;
      const radius = 2.5 + (Math.random() - 0.5) * 0.8;
      const height = (Math.random() - 0.5) * 0.6;
      
      electronPositions[i * 3] = Math.cos(angle) * radius;
      electronPositions[i * 3 + 1] = height;
      electronPositions[i * 3 + 2] = Math.sin(angle) * radius;

      const color = new THREE.Color().setHSL(0.55, 1, 0.6);
      electronColors[i * 3] = color.r;
      electronColors[i * 3 + 1] = color.g;
      electronColors[i * 3 + 2] = color.b;

      // Electrons move faster (lighter mass)
      const speed = Math.sqrt(temperature / 10000) * 0.5;
      this.electronVelocities.push(new THREE.Vector3(
        (Math.random() - 0.5) * speed,
        (Math.random() - 0.5) * speed * 0.3,
        (Math.random() - 0.5) * speed
      ));
    }

    electronGeometry.setAttribute('position', new THREE.BufferAttribute(electronPositions, 3));
    electronGeometry.setAttribute('color', new THREE.BufferAttribute(electronColors, 3));

    const electronMaterial = new THREE.PointsMaterial({
      size: 0.08,
      vertexColors: true,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });

    this.electrons = new THREE.Points(electronGeometry, electronMaterial);
    this.group.add(this.electrons);

    // Plasma glow (volumetric effect)
    const glowGeometry = new THREE.TorusGeometry(3, 1.2, 24, 64);
    const glowMaterial = new THREE.MeshBasicMaterial({ 
      color: new THREE.Color().setHSL(0.05 + temperature / 300000, 0.8, 0.5),
      transparent: true, 
      opacity: 0.12,
      side: THREE.DoubleSide
    });
    const glow = new THREE.Mesh(glowGeometry, glowMaterial);
    this.group.add(glow);

    scene.add(this.group);
  }

  update(delta: number, _state: SimulationState): void {
    if (!this.group || !this.ions || !this.electrons) return;
    this.time += delta;
    this.fusionTimer += delta;
    
    const dt = Math.min(delta, 0.02);
    const temperature = (this.params.temperature as number) || 50000;
    const showFusion = this.params.showFusion !== false;

    // Fusion reactions (at high temperatures)
    if (showFusion && temperature > 40000 && this.fusionTimer > 0.5 + Math.random()) {
      this.createFusionReaction();
      this.fusionTimer = 0;
    }

    // Update fusion flashes
    this.fusionFlashes = this.fusionFlashes.filter(flash => {
      flash.scale.multiplyScalar(1.1);
      const material = flash.material as THREE.MeshBasicMaterial;
      material.opacity -= dt * 3;
      if (material.opacity <= 0) {
        flash.parent?.remove(flash);
        flash.geometry.dispose();
        material.dispose();
        return false;
      }
      return true;
    });

    // Update ions
    const ionPositions = (this.ions.geometry.attributes.position as THREE.BufferAttribute).array as Float32Array;
    
    for (let i = 0; i < this.ionVelocities.length; i++) {
      const x = ionPositions[i * 3];
      const y = ionPositions[i * 3 + 1];
      const z = ionPositions[i * 3 + 2];
      
      // Toroidal magnetic confinement
      const angle = Math.atan2(z, x);
      const radius = Math.sqrt(x * x + z * z);
      const targetRadius = 3;
      
      // Magnetic force toward toroidal center (Lorentz force)
      const radialForce = (targetRadius - radius) * 3;
      this.ionVelocities[i].x += Math.cos(angle) * radialForce * dt;
      this.ionVelocities[i].z += Math.sin(angle) * radialForce * dt;
      
      // Vertical confinement
      this.ionVelocities[i].y += -y * 4 * dt;
      
      // Toroidal flow (plasma current)
      const flowSpeed = 1.5;
      this.ionVelocities[i].x += -Math.sin(angle) * flowSpeed * dt;
      this.ionVelocities[i].z += Math.cos(angle) * flowSpeed * dt;
      
      // Thermal motion (temperature-dependent)
      const thermalSpeed = Math.sqrt(temperature / 50000) * 0.3;
      this.ionVelocities[i].x += (Math.random() - 0.5) * thermalSpeed * dt;
      this.ionVelocities[i].y += (Math.random() - 0.5) * thermalSpeed * 0.3 * dt;
      this.ionVelocities[i].z += (Math.random() - 0.5) * thermalSpeed * dt;
      
      // Damping (collisions)
      this.ionVelocities[i].multiplyScalar(0.98);
      
      // Update positions
      ionPositions[i * 3] += this.ionVelocities[i].x * dt;
      ionPositions[i * 3 + 1] += this.ionVelocities[i].y * dt;
      ionPositions[i * 3 + 2] += this.ionVelocities[i].z * dt;
    }

    (this.ions.geometry.attributes.position as THREE.BufferAttribute).needsUpdate = true;

    // Update electrons (similar but faster)
    const electronPositions = (this.electrons.geometry.attributes.position as THREE.BufferAttribute).array as Float32Array;
    
    for (let i = 0; i < this.electronVelocities.length; i++) {
      const x = electronPositions[i * 3];
      const y = electronPositions[i * 3 + 1];
      const z = electronPositions[i * 3 + 2];
      
      const angle = Math.atan2(z, x);
      const radius = Math.sqrt(x * x + z * z);
      const targetRadius = 3;
      
      // Electrons respond more strongly to magnetic field
      const radialForce = (targetRadius - radius) * 4;
      this.electronVelocities[i].x += Math.cos(angle) * radialForce * dt;
      this.electronVelocities[i].z += Math.sin(angle) * radialForce * dt;
      
      this.electronVelocities[i].y += -y * 5 * dt;
      
      // Electrons flow opposite to ions
      const flowSpeed = -2;
      this.electronVelocities[i].x += -Math.sin(angle) * flowSpeed * dt;
      this.electronVelocities[i].z += Math.cos(angle) * flowSpeed * dt;
      
      const thermalSpeed = Math.sqrt(temperature / 50000) * 0.5;
      this.electronVelocities[i].x += (Math.random() - 0.5) * thermalSpeed * dt;
      this.electronVelocities[i].y += (Math.random() - 0.5) * thermalSpeed * 0.3 * dt;
      this.electronVelocities[i].z += (Math.random() - 0.5) * thermalSpeed * dt;
      
      this.electronVelocities[i].multiplyScalar(0.97);
      
      electronPositions[i * 3] += this.electronVelocities[i].x * dt;
      electronPositions[i * 3 + 1] += this.electronVelocities[i].y * dt;
      electronPositions[i * 3 + 2] += this.electronVelocities[i].z * dt;
    }

    (this.electrons.geometry.attributes.position as THREE.BufferAttribute).needsUpdate = true;
    
    // Animate glow
    const glow = this.group.children.find(child => 
      child instanceof THREE.Mesh && child.geometry instanceof THREE.TorusGeometry
    );
    if (glow && glow instanceof THREE.Mesh) {
      glow.rotation.y += delta * 0.3;
      const material = glow.material as THREE.MeshBasicMaterial;
      material.opacity = 0.12 + Math.sin(this.time * 3) * 0.04;
      
      // Color changes with temperature
      const tempColor = new THREE.Color().setHSL(0.05 + temperature / 300000, 0.8, 0.5);
      material.color = tempColor;
    }

    // Animate magnetic field lines
    this.magneticFieldLines.forEach((line, idx) => {
      line.rotation.y += delta * 0.1 * (idx % 2 === 0 ? 1 : -1);
    });
  }

  private createFusionReaction(): void {
    if (!this.scene) return;

    // Random position in plasma core
    const angle = Math.random() * Math.PI * 2;
    const radius = 2 + Math.random();
    const position = new THREE.Vector3(
      Math.cos(angle) * radius,
      (Math.random() - 0.5) * 0.4,
      Math.sin(angle) * radius
    );

    // Fusion flash
    const flashGeometry = new THREE.SphereGeometry(0.2, 16, 16);
    const flashMaterial = new THREE.MeshBasicMaterial({
      color: 0xffff00,
      transparent: true,
      opacity: 1
    });
    const flash = new THREE.Mesh(flashGeometry, flashMaterial);
    flash.position.copy(position);
    this.group?.add(flash);
    this.fusionFlashes.push(flash);
  }

  reset(): void {
    if (this.scene) {
      this.cleanup();
      this.initialize(this.scene, this.params);
    }
  }

  cleanup(): void {
    if (this.group) {
      this.group.children.forEach(child => {
        if (child instanceof THREE.Mesh) {
          child.geometry.dispose();
          (child.material as THREE.Material).dispose();
        } else if (child instanceof THREE.Line) {
          child.geometry.dispose();
          (child.material as THREE.Material).dispose();
        } else if (child instanceof THREE.Points) {
          child.geometry.dispose();
          (child.material as THREE.Material).dispose();
        }
      });
      this.group.parent?.remove(this.group);
    }
    this.fusionFlashes.forEach(flash => {
      flash.geometry.dispose();
      (flash.material as THREE.Material).dispose();
    });
    this.ionVelocities = [];
    this.electronVelocities = [];
    this.fusionFlashes = [];
    this.magneticFieldLines = [];
  }

  exportData(): unknown {
    const temperature = this.params.temperature as number || 50000;
    const density = this.params.density as number || 1;
    
    // Debye length calculation
    const debyeLength = Math.sqrt((8.85e-12 * 1.38e-23 * temperature) / (density * 1e19 * 1.6e-19 * 1.6e-19));
    
    // Plasma frequency
    const plasmaFreq = Math.sqrt((density * 1e19 * 1.6e-19 * 1.6e-19) / (8.85e-12 * 9.11e-31));
    
    return {
      time: this.time,
      temperature,
      density,
      debyeLength,
      plasmaFrequency: plasmaFreq,
      fusionEvents: this.fusionFlashes.length,
      ionCount: this.ionVelocities.length,
      electronCount: this.electronVelocities.length
    };
  }
}
